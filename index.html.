<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06111f"><title>JARVIS 2.3 · Gedächtnis-Fix</title><style>
*{box-sizing:border-box}body{margin:0;background:#071523;color:#e8f8ff;font:15px -apple-system,BlinkMacSystemFont,Arial,sans-serif}header{padding:22px 18px 14px;background:#0a2135;border-bottom:1px solid #23536b}h1{margin:0;color:#69dcff;letter-spacing:4px;font-size:29px}h2{font-size:21px;margin:0 0 12px}h3{font-size:16px;margin:0 0 8px;color:#8fe7ff}p{line-height:1.55;color:#b2cddd}small{color:#8fb0c5}.status{display:inline-block;margin-top:8px;border:1px solid #34708a;border-radius:30px;padding:6px 11px;color:#a1e7fa;font-size:12px}.tabs{display:flex;gap:8px;overflow-x:auto;padding:12px 12px 4px;background:#091b2c;position:sticky;top:0;z-index:5}input[name=tab]{position:absolute;opacity:0;pointer-events:none}label{display:inline-block;background:#153249;color:#d8f3ff;border:1px solid #315a70;border-radius:10px;padding:11px 15px;white-space:nowrap;font-weight:600;cursor:pointer}.panels{padding:15px;max-width:1000px;margin:auto}.panel{display:none}.card{background:#10263a;border:1px solid #2a5068;border-radius:16px;padding:17px;margin-bottom:12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}.grid .card{margin:0}.orb{height:125px;width:125px;border:2px solid #60dcff;border-radius:100%;margin:12px auto;display:grid;place-items:center;color:#b4f1ff;letter-spacing:2px;font-weight:700;box-shadow:0 0 30px #1a9cc877,inset 0 0 28px #1a9cc844}.btn,a.btn{display:inline-block;text-decoration:none;color:#e6faff;background:#18516b;border:1px solid #398ba9;border-radius:10px;padding:11px 14px;margin:5px 4px 5px 0;font-weight:600}button{font:inherit;cursor:pointer}input[type=text],textarea{background:#081b2b;color:#e9faff;border:1px solid #3a6680;border-radius:9px;padding:12px;width:100%;font:inherit;margin:6px 0}textarea{min-height:110px}ul{padding-left:22px}li{padding:5px 0}#t-home:checked~.panels #home,#t-ai:checked~.panels #ai,#t-light:checked~.panels #light,#t-plan:checked~.panels #plan,#t-apps:checked~.panels #apps,#t-more:checked~.panels #more,#t-setup:checked~.panels #setup{display:block}#t-home:checked~.tabs label[for=t-home],#t-ai:checked~.tabs label[for=t-ai],#t-light:checked~.tabs label[for=t-light],#t-plan:checked~.tabs label[for=t-plan],#t-apps:checked~.tabs label[for=t-apps],#t-more:checked~.tabs label[for=t-more],#t-setup:checked~.tabs label[for=t-setup]{background:#176285;border-color:#7be2ff}.muted{color:#91afc1;font-size:13px}.on{background:#16654f}.footer{text-align:center;padding:18px;color:#829fb2;font-size:12px}@media(min-width:750px){.panels{padding:25px}.grid{grid-template-columns:repeat(3,1fr)}}
select{background:#081b2b;color:#e9faff;border:1px solid #3a6680;border-radius:9px;padding:12px;width:100%;font:inherit;margin:6px 0}#customLinks .entry,#automationList .entry{padding:12px;margin:8px 0;border:1px solid #2a5068;border-radius:10px;background:#0b2031;overflow-wrap:anywhere}.entry button{float:right}.entry a{color:#80e7ff}.card label:not(.btn){display:block;color:#b7d9e8;margin-top:10px}ol li{padding:7px 0}.chatlog{max-height:340px;min-height:110px;overflow:auto;background:#081b2b;border:1px solid #315a70;border-radius:12px;padding:12px;margin:10px 0}.chatmsg{padding:10px;margin:7px 0;border-radius:10px;background:#143247;overflow-wrap:anywhere}.chatmsg.user{background:#1a4961}.chatmsg strong{color:#83e5ff}.knowledge .entry{margin:8px 0;padding:10px;background:#0b2031;border:1px solid #2a5068;border-radius:9px;overflow-wrap:anywhere}.knowledge button{float:right}.knowledge small{display:block}</style></head><body>
<header><h1>JARVIS 2.0</h1><small>MOBILE CONTROL CENTER · PERSONAL SETUP</small><div><span class="status">● MOBILE MODUS · Offline nutzbar</span></div></header>
<input type="radio" name="tab" id="t-home" checked><input type="radio" name="tab" id="t-ai"><input type="radio" name="tab" id="t-light"><input type="radio" name="tab" id="t-plan"><input type="radio" name="tab" id="t-apps"><input type="radio" name="tab" id="t-more"><input type="radio" name="tab" id="t-setup">
<nav class="tabs"><label for="t-home">⌂ Start</label><label for="t-ai">✦ KI</label><label for="t-light">☼ Licht</label><label for="t-plan">☷ Planung</label><label for="t-apps">▦ Apps</label><label for="t-more">⚙ Mehr</label><label for="t-setup">✧ Setup</label></nav>
<main class="panels">
<section class="panel" id="home"><h2>Willkommen zurück</h2><div class="card"><div class="orb">JARVIS</div><p style="text-align:center">Deine mobile Kommandozentrale ist bereit.</p><p class="muted" style="text-align:center">Dein persönliches Setup kannst du jetzt vorbereiten und exportieren.</p></div><div class="grid"><div class="card"><h3>✦ KI-Assistent</h3><p>Chat und Sprachsteuerung</p><label for="t-ai">Öffnen</label></div><div class="card"><h3>☼ Smart Home</h3><p>Govee-Vorschau</p><label for="t-light">Öffnen</label></div><div class="card"><h3>☷ Planung</h3><p>Aufgaben und Notizen</p><label for="t-plan">Öffnen</label></div><div class="card"><h3>▦ Verknüpfungen</h3><p>Apps direkt starten</p><label for="t-apps">Öffnen</label></div><div class="card"><h3>⚙ Erweiterungen</h3><p>16 geplante Module</p><label for="t-more">Öffnen</label></div><div class="card"><h3>✧ Persönliches Setup</h3><p>Links, Automationen und Export</p><label for="t-setup">Öffnen</label></div></div></section>
<section class="panel" id="ai"><h2>✦ JARVIS · Lernfähige KI</h2>
<div class="card"><h3>◉ Eigenes Gedächtnis</h3><p>Offline-Lernmodus: JARVIS merkt sich Informationen, die du ihm beibringst. Für freie KI-Antworten verbinden wir später Ollama.</p><div id="aiHistory" class="chatlog" aria-live="polite"><p class="muted">JARVIS: Bereit. Schreib „Merke: Mein Lieblingsspiel ist Minecraft“ oder frag „Was ist mein Lieblingsspiel?“</p></div><textarea id="aiInput" placeholder="Frag JARVIS etwas oder bring ihm etwas bei …" rows="3"></textarea><button class="btn" onclick="jarvisSend()">➤ Senden</button><button class="btn" onclick="jarvisVoice()">♫ Antwort vorlesen</button><p class="muted" id="aiStatus">Lernmodus · lokal · ohne PC</p><button class="btn" onclick="jarvisTestStorage()">✓ Speicherung prüfen</button><p class="muted" id="storageStatus">Speicherstatus wird geprüft …</p></div>
<div class="card"><h3>✧ Wissen verwalten</h3><label>Was soll JARVIS wissen?</label><input type="text" id="learnKey" placeholder="z. B. Lieblingsspiel"><input type="text" id="learnValue" placeholder="z. B. Minecraft"><button class="btn" onclick="jarvisTeach()">+ Wissen speichern</button><div id="knowledgeList" class="knowledge"></div><button class="btn" onclick="jarvisExportMemory()">↓ KI-Gedächtnis exportieren</button><label class="btn" for="jarvisImport">↑ Gedächtnis importieren</label><input type="file" id="jarvisImport" accept=".json,application/json" style="display:none" onchange="jarvisImportMemory(this)"><p class="muted">Speichere hier keine Passwörter, API-Schlüssel oder andere Geheimnisse. Das Wissen liegt lokal im Browser, solange dessen Speicher erhalten bleibt.</p></div>
<div class="card"><h3>Später: Ollama am Windows-PC</h3><p>Unser nächster Schritt: JARVIS nutzt dein qwen3:4b für echte Antworten und ruft vorher die passenden Erinnerungen ab. Das Sprachmodell wird dadurch nicht automatisch nachtrainiert.</p><a class="btn" href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer">Online-KI öffnen ↗</a></div></section>
<section class="panel" id="light"><h2>☼ Govee Smart Home</h2><div class="card"><p>Diese fünf Schalter sind eine <strong>Vorschau</strong>. Sie schalten noch keine echten LEDs.</p></div><div class="grid"><div class="card"><h3>Obere LEDs</h3><button class="btn" onclick="toggle(this)">Demo: Aus</button></div><div class="card"><h3>Untere LEDs</h3><button class="btn" onclick="toggle(this)">Demo: Aus</button></div><div class="card"><h3>Zimmerlicht 1</h3><button class="btn" onclick="toggle(this)">Demo: Aus</button></div><div class="card"><h3>Zimmerlicht 2</h3><button class="btn" onclick="toggle(this)">Demo: Aus</button></div><div class="card"><h3>TV LEDs</h3><button class="btn" onclick="toggle(this)">Demo: Aus</button></div></div></section>
<section class="panel" id="plan"><h2>☷ Planung</h2><div class="card"><h3>Aufgaben</h3><input type="text" id="task" placeholder="Neue Aufgabe ..."><button class="btn" onclick="addTask()">+ Hinzufügen</button><ul id="tasks"></ul><p class="muted">Aufgaben werden lokal gespeichert, wenn Safari die Speicherung erlaubt.</p></div><div class="card"><h3>Notizen</h3><textarea id="notes" placeholder="Deine Ideen für JARVIS ..."></textarea><button class="btn" onclick="saveNotes()">Notizen speichern</button><p id="saved" class="muted">Speicherung nur auf diesem Gerät, soweit vom Browser erlaubt.</p></div><div class="card"><h3>Kalender</h3><a class="btn" href="https://calendar.google.com/" target="_blank">Kalender öffnen ↗</a></div></section>
<section class="panel" id="apps"><h2>▦ Apps und Dienste</h2><div class="card"><h3>Direkte Verknüpfungen</h3><p>Diese Links öffnen echte Websites. Die Konten werden nicht automatisch mit JARVIS verbunden.</p><a class="btn" href="https://web.whatsapp.com/" target="_blank">WhatsApp ↗</a><a class="btn" href="https://mail.google.com/" target="_blank">Gmail ↗</a><a class="btn" href="https://calendar.google.com/" target="_blank">Kalender ↗</a><a class="btn" href="https://open.spotify.com/" target="_blank">Spotify ↗</a><a class="btn" href="https://discord.com/app" target="_blank">Discord ↗</a><a class="btn" href="https://chatgpt.com/" target="_blank">ChatGPT ↗</a><div class="card"><h3>Eigene Links</h3><p>Neue Links kannst du im Setup hinzufügen.</p><div id="appCustomLinks"></div><label for="t-setup">Setup öffnen</label></div></section>
<section class="panel" id="more"><h2>⚙ Module und System</h2><div class="card"><h3>Geplante Module</h3><div class="grid"><div>KI-Assistent</div><div>Govee Smart Home</div><div>PC-Steuerung</div><div>WhatsApp</div><div>E-Mail</div><div>Kalender</div><div>Aufgaben</div><div>Systemmonitor</div><div>App-Launcher</div><div>Spotify</div><div>Wetter</div><div>Automationen</div><div>Benachrichtigungen</div><div>Dateiverwaltung</div><div>Gaming & Discord</div><div>Sprachsteuerung</div></div></div><div class="card"><h3>Verbindungsstatus</h3><p>📱 iPhone-Oberfläche: <strong>Offline</strong></p><p>💻 Windows-JARVIS: <strong>Nicht verbunden</strong></p><p>🔒 Fernzugriff: <strong>Noch nicht eingerichtet</strong></p><p class="muted">Für echte PC-Befehle richten wir heute Abend einen geschützten Zugang ein.</p></div></section>
<section class="panel" id="setup"><h2>✧ JARVIS einrichten</h2>
<div class="card"><h3>Dein Assistent</h3><p>Diese Angaben werden nur lokal auf deinem Gerät gespeichert. Keine Passwörter oder API-Schlüssel eintragen.</p><label>Wie soll JARVIS dich ansprechen?</label><input type="text" id="nickname" placeholder="Optionaler Anzeigename"><label>Bevorzugte KI</label><select id="aiChoice"><option value="ollama">Lokal: Ollama qwen3:4b (später am PC)</option><option value="chatgpt">ChatGPT im Browser</option></select><label>Sprache / Stil</label><select id="voiceChoice"><option value="de">Deutsch · futuristisch und direkt</option><option value="en">Englisch · futuristisch</option></select><button class="btn" onclick="saveSetup()">Einstellungen speichern</button><p id="setupMsg" class="muted"></p></div>
<div class="card"><h3>Eigene Schnellzugriffe</h3><p>Trage Websites ein, die du häufig verwendest. Nur https://-Links werden geöffnet.</p><input type="text" id="linkName" placeholder="Name, z. B. YouTube"><input type="text" id="linkUrl" placeholder="https://..."><button class="btn" onclick="addLink()">+ Link hinzufügen</button><div id="customLinks"></div></div>
<div class="card"><h3>Automationen planen</h3><p>Wir speichern die Regeln als Entwürfe. Sie werden noch nicht automatisch ausgeführt.</p><input type="text" id="autoName" placeholder="Name, z. B. Gaming-Modus"><textarea id="autoRule" placeholder="Wenn ich Gaming-Modus sage, öffne Discord und Spotify und stelle Govee auf Blau."></textarea><button class="btn" onclick="addAutomation()">+ Regel speichern</button><div id="automationList"></div></div>
<div class="card"><h3>Fernsteuerung vorbereiten</h3><p>Dein PC benötigt heute Abend den JARVIS-Server und eine sichere Verbindung, z. B. über Tailscale. Keine offenen Router-Ports.</p><label>Geplante PC-Adresse (optional, später)</label><input type="text" id="pcAddress" placeholder="https://dein-pc.example oder Tailscale-Adresse"><button class="btn" onclick="saveSetup()">Verbindungsplan speichern</button><p class="muted">Keine Tokens, Passwörter oder privaten Schlüssel hier hinterlegen. Eine echte Verbindung wird hier noch nicht hergestellt.</p></div>
<div class="card"><h3>Deine Daten sichern</h3><p>Exportiere Aufgaben, Notizen, Einstellungen, Schnellzugriffe und Automationsentwürfe als JSON-Datei. Diese können wir heute Abend auf Windows übernehmen.</p><button class="btn" onclick="exportConfig()">↓ Konfiguration exportieren</button><label class="btn" for="importFile">↑ Konfiguration importieren</label><input id="importFile" type="file" accept="application/json,.json" onchange="importConfig(this)" style="display:none"><p id="exportMsg" class="muted">Export enthält keine Zugangsdaten.</p></div>
<div class="card"><h3>Heute Abend</h3><ol><li>Windows-Starterpaket starten</li><li>Ollama und ElevenLabs überprüfen</li><li>Govee-Geräte verbinden</li><li>Tailscale für sicheren Fernzugriff einrichten</li><li>Diese Konfiguration importieren</li><li>Mobile Oberfläche mit Backend koppeln</li></ol></div>
</section></main><div class="footer">JARVIS 2.2 · Sichtbare Oberfläche auch ohne JavaScript</div>
<script>
const KEY='jarvis_mobile_21';
let cfg={nickname:'',aiChoice:'ollama',voiceChoice:'de',pcAddress:'',links:[],automations:[]};
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function getConfig(){try{const v=JSON.parse(localStorage.getItem(KEY)||'{}');if(v&&typeof v==='object')cfg={...cfg,...v,links:Array.isArray(v.links)?v.links:[],automations:Array.isArray(v.automations)?v.automations:[]}}catch(e){}}
function saveCfg(){try{localStorage.setItem(KEY,JSON.stringify(cfg));return true}catch(e){return false}}
function loadSetup(){getConfig();for(const id of ['nickname','aiChoice','voiceChoice','pcAddress']){const e=document.getElementById(id);if(e)e.value=cfg[id]||''}drawLinks();drawAutomations()}
function saveSetup(){for(const id of ['nickname','aiChoice','voiceChoice','pcAddress'])cfg[id]=document.getElementById(id).value;document.getElementById('setupMsg').textContent=saveCfg()?'Einstellungen gespeichert ✓':'Lokale Speicherung nicht verfügbar. Bitte exportieren.'}
function safeUrl(raw){try{const u=new URL(raw);return u.protocol==='https:'?u.href:null}catch(e){return null}}
function addLink(){const name=document.getElementById('linkName').value.trim(),url=safeUrl(document.getElementById('linkUrl').value.trim());if(!name||!url){alert('Bitte Namen und gültigen https://-Link eingeben.');return}cfg.links.push({name,url});saveCfg();document.getElementById('linkName').value='';document.getElementById('linkUrl').value='';drawLinks()}
function removeLink(i){cfg.links.splice(i,1);saveCfg();drawLinks()}
function drawLinks(){document.getElementById('appCustomLinks').innerHTML=cfg.links.map(x=>`<a class="btn" href="${esc(safeUrl(x.url)||'#')}" target="_blank" rel="noopener noreferrer">${esc(x.name)} ↗</a>`).join('')||'<p class="muted">Noch keine eigenen Links.</p>';document.getElementById('customLinks').innerHTML=cfg.links.map((x,i)=>`<div class="entry"><button class="btn" onclick="removeLink(${i})">×</button><a href="${esc(safeUrl(x.url)||'#')}" target="_blank" rel="noopener noreferrer">${esc(x.name)} ↗</a></div>`).join('')||'<p class="muted">Noch keine eigenen Links.</p>'}
function addAutomation(){const name=document.getElementById('autoName').value.trim(),rule=document.getElementById('autoRule').value.trim();if(!name||!rule)return;cfg.automations.push({name,rule});saveCfg();document.getElementById('autoName').value='';document.getElementById('autoRule').value='';drawAutomations()}
function removeAutomation(i){cfg.automations.splice(i,1);saveCfg();drawAutomations()}
function drawAutomations(){document.getElementById('automationList').innerHTML=cfg.automations.map((x,i)=>`<div class="entry"><button class="btn" onclick="removeAutomation(${i})">×</button><strong>${esc(x.name)}</strong><p>${esc(x.rule)}</p><small>Entwurf · noch nicht aktiv</small></div>`).join('')||'<p class="muted">Noch keine Regeln geplant.</p>'}
function exportConfig(){saveSetup();const tasks=[...document.querySelectorAll('#tasks li')].map(x=>x.firstChild.textContent.trim()).filter(Boolean);const payload={format:'jarvis-mobile-2.1',exportedAt:new Date().toISOString(),settings:cfg,tasks,notes:document.getElementById('notes').value,aiMemory:jarvisMemoryData()};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='JARVIS_Handy_Konfiguration.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000);document.getElementById('exportMsg').textContent='Export angestoßen. Prüfe die Downloads in Safari.'}
function importConfig(input){const f=input.files&&input.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const data=JSON.parse(r.result);if(data.format!=='jarvis-mobile-2.1'||!data.settings||!Array.isArray(data.tasks))throw Error('Unbekanntes Dateiformat');cfg={...cfg,...data.settings,links:(data.settings.links||[]).filter(x=>x&&safeUrl(x.url)&&typeof x.name==='string'),automations:(data.settings.automations||[]).filter(x=>x&&typeof x.name==='string'&&typeof x.rule==='string')};saveCfg();if(data.aiMemory&&data.aiMemory.format==='jarvis-memory-v1'&&data.aiMemory.facts&&typeof data.aiMemory.facts==='object'&&!Array.isArray(data.aiMemory.facts)){jarvisDB.facts=Object.fromEntries(Object.entries(data.aiMemory.facts).filter(([k,v])=>typeof k==='string'&&k.length<=120&&typeof v==='string'&&v.length<=1000).slice(0,200));jarvisDB.history=Array.isArray(data.aiMemory.history)?data.aiMemory.history.filter(x=>x&&typeof x.message==='string'&&['Du','JARVIS'].includes(x.role)).slice(-100):[];jarvisSave();jarvisDraw()}document.getElementById('notes').value=typeof data.notes==='string'?data.notes:'';saveNotes();document.getElementById('tasks').innerHTML='';data.tasks.filter(x=>typeof x==='string').forEach(renderTask);persistTasks();loadSetup();document.getElementById('exportMsg').textContent='Konfiguration importiert ✓'}catch(e){document.getElementById('exportMsg').textContent='Import fehlgeschlagen: '+e.message}};r.readAsText(f)}
document.addEventListener('DOMContentLoaded',loadSetup);

try{const n=localStorage.getItem('jarvis_fix_notes');if(n)document.getElementById('notes').value=n;const a=JSON.parse(localStorage.getItem('jarvis_fix_tasks')||'[]');a.forEach(renderTask)}catch(e){}
function toggle(b){const on=b.textContent.includes('Aus');b.textContent='Demo: '+(on?'Ein':'Aus');b.classList.toggle('on',on)}
function copyPrompt(){const t=document.getElementById('prompt').value;if(!t)return;try{navigator.clipboard.writeText(t).then(()=>document.getElementById('ai-msg').textContent='Befehl kopiert.')}catch(e){document.getElementById('ai-msg').textContent='Bitte Text markieren und kopieren.'}}
function renderTask(s){const li=document.createElement('li');li.textContent=s+' ';const b=document.createElement('button');b.className='btn';b.textContent='✓';b.onclick=()=>{li.remove();persistTasks()};li.appendChild(b);document.getElementById('tasks').appendChild(li)}
function persistTasks(){try{const a=[...document.querySelectorAll('#tasks li')].map(x=>x.firstChild.textContent.trim());localStorage.setItem('jarvis_fix_tasks',JSON.stringify(a))}catch(e){}}
function addTask(){const e=document.getElementById('task');if(!e.value.trim())return;renderTask(e.value.trim());e.value='';persistTasks()}
function saveNotes(){try{localStorage.setItem('jarvis_fix_notes',document.getElementById('notes').value);document.getElementById('saved').textContent='Notizen gespeichert ✓'}catch(e){document.getElementById('saved').textContent='Speichern hier nicht erlaubt. Bitte Text kopieren.'}}

// Offline memory is intentionally independent of the PC backend.
const JMEM='jarvis_memory_v1';
let jarvisDB={facts:{},history:[]};
try {const saved=JSON.parse(localStorage.getItem(JMEM)||'{}');if(saved&&typeof saved==='object'){jarvisDB.facts=saved.facts&&typeof saved.facts==='object'&&!Array.isArray(saved.facts)?saved.facts:{};jarvisDB.history=Array.isArray(saved.history)?saved.history.slice(-100):[]}}catch(e){}
function jarvisSave(){
 try {
  const payload=JSON.stringify(jarvisDB);
  localStorage.setItem(JMEM,payload);
  if(localStorage.getItem(JMEM)!==payload)throw new Error('Lesetest fehlgeschlagen');
  jarvisStorageMessage(true);
  return true;
 }catch(e){jarvisStorageMessage(false);return false}
}
function jarvisStorageMessage(ok){
 const el=document.getElementById('storageStatus');
 if(el)el.textContent=ok?'✓ Lokale Speicherung verfügbar':'⚠ iPhone-Dateivorschau blockiert dauerhafte Speicherung. Exportiere dein Gedächtnis als JSON oder öffne JARVIS als gehostete Website.';
}
function jarvisTestStorage(){
 try{const k='jarvis_test_'+Date.now();localStorage.setItem(k,'ok');const ok=localStorage.getItem(k)==='ok';localStorage.removeItem(k);jarvisStorageMessage(ok)}catch(e){jarvisStorageMessage(false)}
}
function jarvisNorm(s){return String(s||'').toLocaleLowerCase('de-DE').normalize('NFKC').replace(/[^\p{L}\p{N}\s]/gu,' ').replace(/\s+/g,' ').trim()}
function jarvisAdd(role,message,save=true){const div=document.createElement('div');div.className='chatmsg '+(role==='Du'?'user':'');const strong=document.createElement('strong');strong.textContent=role+': ';div.appendChild(strong);div.appendChild(document.createTextNode(message));const box=document.getElementById('aiHistory');box.appendChild(div);box.scrollTop=box.scrollHeight;if(save){jarvisDB.history.push({role,message,time:new Date().toISOString()});jarvisDB.history=jarvisDB.history.slice(-100);jarvisSave()}}
function jarvisDraw(){const box=document.getElementById('aiHistory');box.innerHTML='';jarvisDB.history.forEach(x=>{if(x&&typeof x.message==='string'&&typeof x.role==='string')jarvisAdd(x.role,x.message,false)});const out=document.getElementById('knowledgeList');out.innerHTML='';const keys=Object.keys(jarvisDB.facts).slice(0,200);if(!keys.length){const p=document.createElement('p');p.className='muted';p.textContent='Noch nichts gelernt.';out.appendChild(p)}keys.forEach(k=>{const entry=document.createElement('div');entry.className='entry';const btn=document.createElement('button');btn.className='btn';btn.textContent='Löschen';btn.onclick=()=>{delete jarvisDB.facts[k];jarvisSave();jarvisDraw()};entry.appendChild(btn);const title=document.createElement('strong');title.textContent=k;entry.appendChild(title);const v=document.createElement('small');v.textContent=String(jarvisDB.facts[k]);entry.appendChild(v);out.appendChild(entry)});document.getElementById('aiStatus').textContent=keys.length+' Fakten gespeichert · Offline-Lernmodus'}
function jarvisTeach(){const key=document.getElementById('learnKey').value.trim().slice(0,120),val=document.getElementById('learnValue').value.trim().slice(0,1000);if(!key||!val)return;jarvisDB.facts[key]=val;jarvisSave();jarvisDraw();jarvisAdd('JARVIS','Gelernt: '+key+' = '+val);document.getElementById('learnKey').value='';document.getElementById('learnValue').value=''}
function jarvisAnswer(input){
 const t=input.trim();
 const learn=t.match(/^(?:merke(?: dir)?|lerne|speichere|merk dir)\s*[:,-]?\s*(.+?)\s+(?:ist|sind|=|lautet|heißt)\s+(.+)$/i);
 if(learn){
  const key=learn[1].replace(/^(?:mein|meine|meinen|meinem|der|die|das)\s+/i,'').trim().slice(0,120);
  const value=learn[2].trim().replace(/[.!]$/,'').slice(0,1000);
  if(key&&value){
   const existing=Object.keys(jarvisDB.facts).find(k=>jarvisNorm(k)===jarvisNorm(key));
   jarvisDB.facts[existing||key]=value;
   const saved=jarvisSave();jarvisDraw();
   return 'Gelernt: '+key+' = '+value+'. '+(saved?'Dauerhaft gespeichert.':'Nur für diese Sitzung gemerkt: iOS blockiert die Speicherung. Bitte Gedächtnis exportieren.');
  }
 }
 if(/^(hallo|hi|hey|guten morgen|guten abend)[!. ]*$/i.test(t))return 'Hallo. Ich kann mir Fakten merken. Schreib zum Beispiel: Merke: Lieblingsspiel ist Minecraft';
 if(/(?:was weißt du|was hast du gelernt|was kannst du dir merken)/i.test(t))return Object.keys(jarvisDB.facts).length?'Gespeicherte Fakten: '+Object.entries(jarvisDB.facts).map(([k,v])=>k+' = '+v).join('; ').slice(0,1200):'Noch keine Fakten.';
 const norm=jarvisNorm(t);
 let best=null,score=0;
 for(const [k,v] of Object.entries(jarvisDB.facts)){
  const nk=jarvisNorm(k);if(!nk)continue;
  const terms=nk.split(' ').filter(w=>w.length>2);
  const hits=terms.filter(w=>norm.split(' ').includes(w)).length;
  const sc=norm.includes(nk)?100:(terms.length?hits/terms.length*10:0);
  if(sc>score&&sc>=7){best=[k,v];score=sc}
 }
 if(best)return 'Ich erinnere mich: '+best[0]+' = '+best[1];
 return 'Dazu habe ich noch nichts gelernt. Beispiel: Merke: Lieblingsspiel ist Minecraft';
}
function jarvisSend(){const e=document.getElementById('aiInput'),q=e.value.trim();if(!q)return;jarvisAdd('Du',q);e.value='';const a=jarvisAnswer(q);jarvisAdd('JARVIS',a);window.jarvisLastReply=a}
function jarvisVoice(){const t=window.jarvisLastReply||'JARVIS ist bereit.';if(!('speechSynthesis' in window)){document.getElementById('aiStatus').textContent='Sprachausgabe hier nicht verfügbar.';return}try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='de-DE';u.rate=1;speechSynthesis.speak(u)}catch(e){document.getElementById('aiStatus').textContent='Sprachausgabe blockiert.'}}
function jarvisMemoryData(){return {format:'jarvis-memory-v1',exportedAt:new Date().toISOString(),facts:jarvisDB.facts,history:jarvisDB.history}}
function jarvisDownload(data,name){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),3000)}
function jarvisExportMemory(){jarvisDownload(jarvisMemoryData(),'JARVIS_KI_Gedaechtnis.json');document.getElementById('aiStatus').textContent='Gedächtnis-Export gestartet. Downloads prüfen.'}
function jarvisImportMemory(el){const f=el.files&&el.files[0];if(!f)return;if(f.size>2000000){alert('Datei zu groß.');return}const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(x.format!=='jarvis-memory-v1'||!x.facts||typeof x.facts!=='object'||Array.isArray(x.facts)||!Array.isArray(x.history))throw Error('Ungültiges Format');jarvisDB.facts=Object.fromEntries(Object.entries(x.facts).filter(([k,v])=>typeof k==='string'&&k.length<=120&&typeof v==='string'&&v.length<=1000).slice(0,200));jarvisDB.history=x.history.filter(z=>z&&['Du','JARVIS'].includes(z.role)&&typeof z.message==='string').slice(-100).map(z=>({role:z.role,message:z.message.slice(0,2000),time:String(z.time||'')}));jarvisSave();jarvisDraw();document.getElementById('aiStatus').textContent='Gedächtnis importiert ✓'}catch(e){document.getElementById('aiStatus').textContent='Import fehlgeschlagen: '+e.message}};r.readAsText(f)}
jarvisDraw();
jarvisTestStorage();
</script></body></html>
